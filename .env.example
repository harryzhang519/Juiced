# ─────────────────────────────────────────────────────
#  EV Edge — Environment Variables
#  Copy this file to .env and fill in your values.
#  .env is in .gitignore and will NOT be committed.
# ─────────────────────────────────────────────────────

# Get your key at https://the-odds-api.com (free tier = 500 req/month)
# Leave blank to run in DEMO MODE with mock data.
ODDS_API_KEY=your_key_here

# Flask settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# How many hours before cached odds are considered stale
CACHE_TTL_HOURS=6

# Refresh schedule — cron expression (default: every day at 9 AM)
REFRESH_CRON=0 9 * * *

# Secret key for Flask sessions (change this in production!）
SECRET_KEY=change_me_in_production

# ── Gemini AI (Vision auto-parsing + Bet Diagnosis) ───────
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Admin Access (Protects Verified Ledger on Public Deploy) ──
# Secret PIN to unlock live updating from your phone/browser on Vercel
ADMIN_PIN=your_admin_pin_here

# ── Cloud Database (Supabase PostgreSQL) ──────────────────
# Optional: Set these to persist live updates in the cloud (get free at https://supabase.com)
# If left blank, falls back to local data/pikkit_bets.json automatically
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# ── Player Props (opt-in — uses extra API credits) ────────
# Set to true to enable player prop EV analysis.
# Cost: ~1 API credit per prop market per game per refresh.
# Example: 5 MLB prop markets × 10 games = 50 credits per refresh.
# Defaults to false (off) to protect your monthly quota.
PROPS_ENABLED=false
