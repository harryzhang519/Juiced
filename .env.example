# ─────────────────────────────────────────────────────
#  EV Edge — Environment Variables
#  Copy this file to .env and fill in your values.
#  .env is in .gitignore and will NOT be committed.
# ─────────────────────────────────────────────────────

# Get your key at https://the-odds-api.com (free tier = 500 req/month)
# Leave blank to run in DEMO MODE with mock data.
ODDS_API_KEY=your_key_here

# Flask settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# How many hours before cached odds are considered stale
CACHE_TTL_HOURS=6

# Refresh schedule — cron expression (default: every day at 9 AM)
REFRESH_CRON=0 9 * * *

# Secret key for Flask sessions (change this in production!）
SECRET_KEY=change_me_in_production

# ── Player Props (opt-in — uses extra API credits) ────────
# Set to true to enable player prop EV analysis.
# Cost: ~1 API credit per prop market per game per refresh.
# Example: 5 MLB prop markets × 10 games = 50 credits per refresh.
# Defaults to false (off) to protect your monthly quota.
PROPS_ENABLED=false
